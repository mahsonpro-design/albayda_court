TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Publicly link-shared Google Drive CSV ID used by the existing case_records.py module.
GOOGLE_DRIVE_FILE_ID=YOUR_GOOGLE_DRIVE_FILE_ID_HERE
# Required for the private Android API. Generate a long random value; never commit it.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_DATABASE_PATH=./data/app.sqlite3
# Used only to create the very first administrator. Keep these in host environment secrets.
ADMIN_BOOTSTRAP_NAME=Court Administrator
ADMIN_BOOTSTRAP_PHONE=967700000000
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
# Optional; set true only if you need interactive API docs.
API_DOCS_ENABLED=false
